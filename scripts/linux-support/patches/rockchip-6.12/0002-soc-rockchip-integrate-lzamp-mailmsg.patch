From: LZAMP Project <lzamp@localhost>
Subject: [PATCH] soc: rockchip: integrate LZAMP MailMsg endpoint

Build the LZAMP PSCI CPU lifecycle and four-priority MailMsg endpoint into the
Rockchip kernel. The wrappers reference the canonical sources kept outside the
ignored upstream checkout in the fixed LZAMP project layout.

---
 drivers/soc/rockchip/Kconfig                | 9 +++++++++
 drivers/soc/rockchip/Makefile               | 2 ++
 drivers/soc/rockchip/lzamp_amp_mailmsg.c    | 3 +++
 drivers/soc/rockchip/lzamp_mailmsg_common.c | 3 +++
 4 files changed, 17 insertions(+)
 create mode 100644 drivers/soc/rockchip/lzamp_amp_mailmsg.c
 create mode 100644 drivers/soc/rockchip/lzamp_mailmsg_common.c

diff --git a/drivers/soc/rockchip/Kconfig b/drivers/soc/rockchip/Kconfig
index 972cd679a..ef7e1d592 100644
--- a/drivers/soc/rockchip/Kconfig
+++ b/drivers/soc/rockchip/Kconfig
@@ -36,6 +36,15 @@ config ROCKCHIP_AMP
 	  Say y here to enable Rockchip AMP support.
 	  This option protects resources used by AMP.
 
+config LZAMP_AMP_MAILMSG
+	bool "LZAMP PSCI CPU lifecycle and MailMsg transport"
+	depends on ARM64 && ARM_PSCI_FW && MAILBOX && ROCKCHIP_MBOX
+	help
+	  Build the LZAMP CPU3 image loader, PSCI lifecycle controller and
+	  four-priority MailMsg shared-memory/mailbox transport. This is an
+	  LZAMP board integration driver and is intentionally built-in so that
+	  its device cannot be unloaded while userspace holds MailMsg handles.
+
 config ROCKCHIP_AMP_RPMSG_FILE
 	tristate "Rockchip RPMsg File"
 	depends on ARCH_ROCKCHIP && RPMSG
diff --git a/drivers/soc/rockchip/Makefile b/drivers/soc/rockchip/Makefile
index f002cd3ce..1a9c1dab1 100644
--- a/drivers/soc/rockchip/Makefile
+++ b/drivers/soc/rockchip/Makefile
@@ -4,6 +4,8 @@
 #
 obj-$(CONFIG_ROCKCHIP_AOA_MIDDLEWARE) += aoa_middleware/
 obj-$(CONFIG_ROCKCHIP_AMP) += rockchip_amp.o
+obj-$(CONFIG_LZAMP_AMP_MAILMSG) += lzamp_amp_mailmsg.o
+obj-$(CONFIG_LZAMP_AMP_MAILMSG) += lzamp_mailmsg_common.o
 obj-$(CONFIG_ROCKCHIP_AMP_RPMSG_FILE) += rockchip_amp_rpmsg_file.o
 obj-$(CONFIG_ROCKCHIP_AMP_RPMSG_HEARTBEAT) += rockchip_amp_rpmsg_heartbeat.o
 obj-$(CONFIG_ROCKCHIP_AMP_RPMSG_MCULOG) += rockchip_amp_rpmsg_mculog.o
diff --git a/drivers/soc/rockchip/lzamp_amp_mailmsg.c b/drivers/soc/rockchip/lzamp_amp_mailmsg.c
new file mode 100644
index 000000000..222222222
--- /dev/null
+++ b/drivers/soc/rockchip/lzamp_amp_mailmsg.c
@@ -0,0 +1,3 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Canonical source lives outside the ignored upstream checkout. */
+#include "../../../../../linux/drivers/lzamp_amp_mailmsg.c"
diff --git a/drivers/soc/rockchip/lzamp_mailmsg_common.c b/drivers/soc/rockchip/lzamp_mailmsg_common.c
new file mode 100644
index 000000000..333333333
--- /dev/null
+++ b/drivers/soc/rockchip/lzamp_mailmsg_common.c
@@ -0,0 +1,3 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Canonical source lives outside the ignored upstream checkout. */
+#include "../../../../../linux/drivers/lzamp_mailmsg_common.c"
