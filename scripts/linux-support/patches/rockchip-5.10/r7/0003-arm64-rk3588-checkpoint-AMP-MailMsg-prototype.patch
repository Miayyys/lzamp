diff --git a/drivers/mailbox/rockchip-mailbox.c b/drivers/mailbox/rockchip-mailbox.c
index a4bc367be..c20eccba0 100644
--- a/drivers/mailbox/rockchip-mailbox.c
+++ b/drivers/mailbox/rockchip-mailbox.c
@@ -96,6 +96,11 @@ static int rockchip_mbox_startup(struct mbox_chan *chan)
 	struct rockchip_mbox_chan *chans = chan->con_priv;
 	u32 val = 0U;
 
+	/* A deferred consumer can observe a registered controller before its
+	 * platform private data is available; retry instead of dereferencing it. */
+	if (!mb || !chans)
+		return -EPROBE_DEFER;
+
 	/* Enable the corresponding B2A interrupt */
 	spin_lock(&mb->cfg_lock);
 	val = readl_relaxed(mb->mbox_base + MAILBOX_B2A_INTEN) |
diff --git a/drivers/soc/rockchip/Kconfig b/drivers/soc/rockchip/Kconfig
index 32cb2566c..2db49ea9c 100644
--- a/drivers/soc/rockchip/Kconfig
+++ b/drivers/soc/rockchip/Kconfig
@@ -36,6 +36,24 @@ config ROCKCHIP_AMP
 	  Say y here to enable Rockchip AMP support.
 	  This option protects resources used by AMP.
 
+config ROCKCHIP_AMP_PSCI_PROBE
+	bool "Rockchip AMP PSCI status probe"
+	depends on ROCKCHIP_AMP && ARM64 && ARM_PSCI_FW
+	help
+	  Build the R1 AMP preflight probe. It only asks PSCI for the power
+	  state of the fixed A55 core whose MPIDR is provided by device tree.
+	  It does not start or stop a CPU, configure Rockchip AMP SiP state,
+	  or map AMP shared memory.
+
+config ROCKCHIP_AMP_PSCI_CPU_ON_HEARTBEAT
+	bool "Rockchip AMP one-shot PSCI CPU_ON heartbeat launcher"
+	depends on ROCKCHIP_AMP_PSCI_PROBE && ARM64 && ARM_PSCI_FW
+	help
+	  Build the R1 AMP CPU_ON smoke-test driver.  It exposes a root-only
+	  binary sysfs image loader and requires an explicit "start" write before
+	  it calls PSCI CPU_ON once.  It only supports the fixed A55 core3 and
+	  the reserved Zephyr heartbeat carveout described by device tree.
+
 config ROCKCHIP_AMP_RPMSG_SHAREDMEM
 	tristate "Rockchip AMP RPMsg Shared Memory"
 	depends on ARCH_ROCKCHIP && RPMSG
