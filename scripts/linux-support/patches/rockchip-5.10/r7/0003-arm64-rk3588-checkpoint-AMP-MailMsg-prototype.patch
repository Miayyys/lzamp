diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-hotplug.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-hotplug.dts
new file mode 100644
index 000000000..14a027df8
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-hotplug.dts
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2021 Rockchip Electronics Co., Ltd.
+ */
+
+/dts-v1/;
+
+#include "rk3588s-evb4-lp4x-yyt.dtsi"
+#include "rk3588-linux.dtsi"
+
+/ {
+	model = "Rockchip RK3588S EVB4 LP4X V10 Board";
+	compatible = "rockchip,rk3588s-evb4-lp4x-v10", "rockchip,rk3588";
+
+	/*
+	 * Preserve all CPU nodes so the A76 cluster keeps Linux logical IDs 4-7,
+	 * which the current RKLLM runtime expects. CPU3 will be offlined only
+	 * as a reversible runtime hand-off experiment.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		zephyr_reserved: zephyr@50000000 {
+			reg = <0x0 0x50000000 0x0 0x00100000>;
+			no-map;
+		};
+	};
+};
+
+/* Keep the NPU-only RAM candidate headless. */
+&hdmi0 {
+	status = "disabled";
+};
+
+&hdptxphy_hdmi0 {
+	status = "disabled";
+};
+
+&hdmi0_in_vp1 {
+	status = "disabled";
+};
+
+&hdmi0_sound {
+	status = "disabled";
+};
+
+&display_subsystem {
+	/delete-property/ compatible;
+	status = "disabled";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-mailbox-all.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-mailbox-all.dts
new file mode 100644
index 000000000..b2fd6a584
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-mailbox-all.dts
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RAM-only all-controller mailbox matrix.
+ *
+ * mailbox0 A2B raw 97..100 is experimentally established.  The mailbox1
+ * and mailbox2 groups below are deliberately labelled candidates: this
+ * image tests them with tagged one-message channels and is not a persistent
+ * platform configuration.
+ */
+
+/dts-v1/;
+
+#include "rk3588s-yyt-amp.dts"
+#include <dt-bindings/soc/rockchip-amp.h>
+
+#define CPU_GET_AFFINITY(cpu, cluster) ((cpu) << 8)
+
+/ {
+	rockchip_amp: rockchip-amp {
+		compatible = "rockchip,amp";
+		amp-irqs = /bits/ 64 <
+			/* mailbox0: established A2B raw 97..100 */
+			GIC_AMP_IRQ_CFG_ROUTE(97, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(98, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(99, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(100, 0xd0, CPU_GET_AFFINITY(3, 0))
+			/* mailbox1: candidate A2B raw 105..108 */
+			GIC_AMP_IRQ_CFG_ROUTE(105, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(106, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(107, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(108, 0xd0, CPU_GET_AFFINITY(3, 0))
+			/* mailbox2: candidate A2B raw 113..116 */
+			GIC_AMP_IRQ_CFG_ROUTE(113, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(114, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(115, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(116, 0xd0, CPU_GET_AFFINITY(3, 0))>;
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-mbox0-route-probe.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-mbox0-route-probe.dts
new file mode 100644
index 000000000..a2902de4f
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp-mbox0-route-probe.dts
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RAM-only preflight for the mailbox0 A2B route group.
+ *
+ * The existing AMP tree proves only mailbox0 ch3 -> raw SPI100.  This tree
+ * routes the adjacent candidate group 97..100 to the Linux-excluded CPU3,
+ * but declares no new mailbox client and sends no new message.  It exists
+ * solely to prove that the Rockchip AMP GIC route mechanism is active before
+ * any multi-channel traffic test.
+ */
+
+/dts-v1/;
+
+#include "rk3588s-yyt-amp.dts"
+#include <dt-bindings/soc/rockchip-amp.h>
+
+#define CPU_GET_AFFINITY(cpu, cluster) ((cpu) << 8)
+
+/ {
+	rockchip_amp: rockchip-amp {
+		compatible = "rockchip,amp";
+		amp-irqs = /bits/ 64 <
+			GIC_AMP_IRQ_CFG_ROUTE(97, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(98, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(99, 0xd0, CPU_GET_AFFINITY(3, 0))
+			GIC_AMP_IRQ_CFG_ROUTE(100, 0xd0, CPU_GET_AFFINITY(3, 0))>;
+		status = "okay";
+	};
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp.dts
index 1e75a85f4..efbe5f95b 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-amp.dts
@@ -46,12 +46,52 @@ &display_subsystem {
 	status = "disabled";
 };
 
+/*
+ * The R1 candidate does not need Mali for NPU or PSCI preflight.  The
+ * vendor GPU driver can stall during asynchronous probe on this board, so
+ * keep it outside this headless RAM-only candidate.
+ */
+&gpu {
+	status = "disabled";
+};
+
 /*
 * AMP static-check variant:
 * Linux must neither enumerate cpu_l3 nor allocate Zephyr's image region.
 * This does not start Zephyr or configure the firmware CPU hand-off.
 */
 / {
+	/*
+	 * Runtime preflight only: this node causes one standard PSCI
+	 * AFFINITY_INFO query for the Linux-excluded A55 core3.  The paired
+	 * driver has no CPU_ON path and never calls Rockchip AMP SiP.
+	 */
+	r1_amp_psci_probe: amp-psci-probe {
+		compatible = "youyeetoo,r1-amp-psci-probe";
+		target-mpidr = /bits/ 64 <0x300>;
+		status = "okay";
+	};
+
+	/*
+	 * This driver only stages a user-supplied heartbeat image at probe.
+	 * A root-only sysfs write of the exact word "start" is required before
+	 * its one permitted standard PSCI CPU_ON call.
+	 */
+	r1_amp_cpu_on_heartbeat: amp-cpu-on-heartbeat {
+		compatible = "youyeetoo,r1-amp-psci-cpu-on-heartbeat";
+		memory-region = <&zephyr_reserved>;
+		/* Each V1 channel is held by one full-duplex Linux mailbox client. */
+		mbox-names = "m0ch0", "m0ch1", "m0ch2", "m0ch3";
+		mboxes = <&mailbox0 0>, <&mailbox0 1>,
+			 <&mailbox0 2>, <&mailbox0 3>;
+		target-mpidr = /bits/ 64 <0x300>;
+		zephyr-entry = /bits/ 64 <0x5000100c>;
+		/* MailMsg V2 Zephyr image: 41,008 B; keep the sysfs loader exact. */
+		zephyr-image-size = <0xa030>;
+		status-offset = <0xff000>;
+		status = "okay";
+	};
+
 cpus {
 	cpu-map {
 		cluster0 {
@@ -77,4 +117,8 @@ &arm_pmu {
 			<&cpu_b0>, <&cpu_b1>, <&cpu_b2>, <&cpu_b3>;
 };
 
-/delete-node/ &cpu_l3;
\ No newline at end of file
+/delete-node/ &cpu_l3;
+
+&mailbox0 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox-all-probe.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox-all-probe.dts
new file mode 100644
index 000000000..81ff0fc51
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox-all-probe.dts
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RAM-only coexistence probe for all three RK3588 mailbox controllers.
+ *
+ * Linux binds mailbox0, mailbox1, and mailbox2, but this tree declares no
+ * mailbox clients and sends no mailbox traffic.  The only functional
+ * regression is a known RKNPU/RKLLM model invocation.
+ */
+
+/dts-v1/;
+
+#include "rk3588s-yyt.dts"
+
+&mailbox0 {
+	status = "okay";
+};
+
+&mailbox1 {
+	status = "okay";
+};
+
+&mailbox2 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox1-probe.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox1-probe.dts
new file mode 100644
index 000000000..d1ba179e3
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox1-probe.dts
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RAM-only ownership probe for RK3588 mailbox1.
+ *
+ * This deliberately enables only the Linux mailbox controller.  It defines
+ * no mailbox client, does not reserve/boot a Zephyr CPU, and does not send a
+ * message.  It is for observing whether the normal Linux clock-enable and
+ * controller-probe path can access the MCU_DDR-labelled peripheral.
+ */
+
+/dts-v1/;
+
+#include "rk3588s-yyt.dts"
+
+&mailbox1 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox2-npu-probe.dts b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox2-npu-probe.dts
new file mode 100644
index 000000000..0aaa4df38
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3588s-yyt-mailbox2-npu-probe.dts
@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * RAM-only ownership probe for RK3588 mailbox2 (MCU_NPU-labelled).
+ *
+ * Only the Linux controller is enabled.  No mailbox client is declared and
+ * no message is sent.  The runtime regression is a known RKNPU/RKLLM model
+ * invocation, so a pass only establishes coexistence for that workload.
+ */
+
+/dts-v1/;
+
+#include "rk3588s-yyt.dts"
+
+&mailbox2 {
+	status = "okay";
+};
