+static int mailmsg_ring_result_to_errno(int result)
+{
+	switch (result) {
+	case MAILMSG_RING_OK:
+		return 0;
+	case MAILMSG_RING_EMPTY:
+		return -ENODATA;
+	case MAILMSG_RING_FULL:
+		return -ENOSPC;
+	case MAILMSG_RING_INCOMPLETE:
+		return -EAGAIN;
+	case MAILMSG_RING_BAD_CRC:
+		return -EBADMSG;
+	case MAILMSG_RING_INVALID:
+		return -EPROTO;
+	default:
+		return -EIO;
+	}
+}
