#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

set -euo pipefail

AMP_SYSFS=${AMP_SYSFS:-/sys/bus/platform/devices/amp-cpu-on-heartbeat}
ZEPHYR_IMAGE=${ZEPHYR_IMAGE:-/userdata/lzamp/zephyr/lzamp-zephyr.bin}
AGENT_BASE=${AGENT_BASE:-/userdata/lzamp/agent}
AGENT=${AGENT:-$AGENT_BASE/mailmsg_agent-v7.py}
SERVER_DIR=${SERVER_DIR:-$AGENT_BASE/rkllm-server}
SERVER=${SERVER:-$SERVER_DIR/flask_server.py}
SERVER_LIB=${SERVER_LIB:-$SERVER_DIR/lib}
PYTHONPATH_DIR=${PYTHONPATH_DIR:-$AGENT_BASE/site-packages}
MODEL=${MODEL:-/userdata/lzamp/models/Qwen3.5-0.8B_w8a8_rk3588.rkllm}
TARGET_PLATFORM=${TARGET_PLATFORM:-rk3588-r7}
CPU_LIST=${CPU_LIST:-3-6}
API_URL=${API_URL:-http://127.0.0.1:8080}
PIDFILE=${PIDFILE:-$SERVER_DIR/qwen35-default.pid}
LOGFILE=${LOGFILE:-$SERVER_DIR/qwen35-default.log}

usage()
{
	cat <<'EOF'
Usage: lzamp-runtime start|status|smoke|stop [--with-zephyr]

  start                 Start or reuse Zephyr and the RKLLM API.
  status                Show the AMP/MailMsg and RKLLM API state.
  smoke                 Run READY and zephyr_increment(41) checks.
  stop                  Stop only the RKLLM API.
  stop --with-zephyr    Stop RKLLM, then request a controlled Zephyr stop.
EOF
}

require_file()
{
	if [[ ! -f $1 ]]; then
		echo "missing file: $1" >&2
		exit 1
	fi
}

api_ready()
{
	/usr/bin/python3 - "$API_URL" <<'PY' >/dev/null 2>&1
import sys
import urllib.request

with urllib.request.urlopen(sys.argv[1].rstrip("/") + "/v1/models", timeout=2) as response:
    if response.status != 200:
        raise SystemExit(1)
PY
}

server_pid()
{
	local pid
	[[ -r $PIDFILE ]] || return 1
	read -r pid < "$PIDFILE"
	[[ $pid =~ ^[0-9]+$ ]] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	# A pidfile can survive a reboot or process exit. Never trust the PID alone.
	/usr/bin/python3 - "$pid" "$SERVER" "$MODEL" <<'PY' || return 1
import pathlib
import sys
try:
    args = pathlib.Path('/proc', sys.argv[1], 'cmdline').read_bytes().split(b'\0')
    expected = [sys.argv[2].encode(), sys.argv[3].encode()]
    if not all(value in args for value in expected):
        raise SystemExit(1)
except OSError:
    raise SystemExit(1)
PY
	printf '%s\n' "$pid"
}

server_preflight()
{
	require_file "$SERVER"
	require_file "$MODEL"
	command -v taskset >/dev/null || { echo 'missing command: taskset' >&2; return 1; }
	[[ -d $SERVER_LIB ]] || { echo "missing runtime directory: $SERVER_LIB" >&2; return 1; }
	PYTHONPATH="$PYTHONPATH_DIR" LD_LIBRARY_PATH="$SERVER_LIB" /usr/bin/python3 - <<'PY'
import ctypes
import flask
ctypes.CDLL('librkllmrt.so')
PY
}

mailmsg_field()
{
	grep -o "$1=[^ ]*" "$AMP_SYSFS/status" | head -n 1 || true
}

start_zephyr()
{
	local affinity state
	require_file "$ZEPHYR_IMAGE"
	[[ -d $AMP_SYSFS ]] || { echo "missing AMP device: $AMP_SYSFS" >&2; exit 1; }

	affinity=$(cat "$AMP_SYSFS/affinity_state")
	state=$(mailmsg_field mailmsg_state)
	if [[ $affinity == *'state=on (0)'* ]]; then
		if [[ $state == 'mailmsg_state=active' ]]; then
			echo "zephyr=already-active"
			return
		fi
		echo "CPU3 is on but MailMsg is not active: $state" >&2
		exit 1
	fi

	if [[ $state == 'mailmsg_state=offline' ]]; then
		printf 'rearm\n' > "$AMP_SYSFS/rearm"
	fi
	cat "$ZEPHYR_IMAGE" > "$AMP_SYSFS/image"
	printf 'start\n' > "$AMP_SYSFS/start"
	sleep 1
	affinity=$(cat "$AMP_SYSFS/affinity_state")
	state=$(mailmsg_field mailmsg_state)
	if [[ $affinity != *'state=on (0)'* || $state != 'mailmsg_state=active' ]]; then
		echo "Zephyr did not become active: $affinity $state" >&2
		exit 1
	fi
	echo "zephyr=started"
}

start_server()
{
	local attempt pid
	if api_ready; then
		echo "rkllm=already-ready"
		return
	fi
	if pid=$(server_pid); then
		echo "RKLLM process $pid exists but its API is not ready" >&2
	else
		server_preflight
		mkdir -p "$SERVER_DIR"
		(
			cd "$SERVER_DIR"
			nohup taskset -c "$CPU_LIST" env \
				PYTHONPATH="$PYTHONPATH_DIR" \
				LD_LIBRARY_PATH="$SERVER_LIB" \
				/usr/bin/python3 "$SERVER" \
				--rkllm_model_path "$MODEL" \
				--target_platform "$TARGET_PLATFORM" \
				> "$LOGFILE" 2>&1 &
			echo "$!" > "$PIDFILE"
		)
		# Give nohup/taskset time to exec Python before checking process identity.
		for attempt in $(seq 1 10); do
			if pid=$(server_pid); then break; fi
			sleep 0.1
		done
		if ! pid=$(server_pid); then
			echo "RKLLM failed to start; see $LOGFILE" >&2
			tail -n 40 "$LOGFILE" >&2 || true
			return 1
		fi
		echo "rkllm=starting pid=$pid"
	fi

	for attempt in $(seq 1 60); do
		if api_ready; then
			echo "rkllm=ready attempt=$attempt"
			return
		fi
		sleep 2
	done
	echo "RKLLM API did not become ready; see $LOGFILE" >&2
	tail -n 40 "$LOGFILE" >&2 || true
	exit 1
}

show_status()
{
	local pid
	uname -r
	if [[ -d $AMP_SYSFS ]]; then
		cat "$AMP_SYSFS/affinity_state"
		printf '%s %s\n' "$(mailmsg_field mailmsg_state)" "$(mailmsg_field session)"
	else
		echo "amp=missing"
	fi
	if pid=$(server_pid); then
		echo "rkllm_process=running pid=$pid"
	else
		echo "rkllm_process=stopped"
	fi
	if api_ready; then
		echo "rkllm_api=ready url=$API_URL"
	else
		echo "rkllm_api=not-ready url=$API_URL"
	fi
}

run_smoke()
{
	require_file "$AGENT"
	api_ready || { echo "RKLLM API is not ready" >&2; exit 1; }
	/usr/bin/python3 "$AGENT" --server "$API_URL" \
		--chat-smoke 'Reply with READY only' --api-timeout 120
	/usr/bin/python3 "$AGENT" --server "$API_URL" \
		--prompt 'Increment 41 using the registered tool' --native-tools \
		--api-timeout 120 --timeout-ms 2000
}

stop_server()
{
	local pid
	if ! pid=$(server_pid); then
		echo "rkllm=already-stopped"
		return
	fi
	kill -TERM "$pid"
	for _ in $(seq 1 30); do
		if ! kill -0 "$pid" 2>/dev/null; then
			rm -f "$PIDFILE"
			echo "rkllm=stopped"
			return
		fi
		sleep 1
	done
	echo "RKLLM process $pid did not stop after SIGTERM" >&2
	exit 1
}

stop_zephyr()
{
	local affinity
	affinity=$(cat "$AMP_SYSFS/affinity_state")
	if [[ $affinity == *'state=off (1)'* ]]; then
		echo "zephyr=already-off"
		return
	fi
	printf 'stop\n' > "$AMP_SYSFS/mailmsg_stop"
	sleep 1
	affinity=$(cat "$AMP_SYSFS/affinity_state")
	if [[ $affinity != *'state=off (1)'* ]]; then
		echo "Zephyr controlled stop failed: $affinity" >&2
		exit 1
	fi
	echo "zephyr=stopped"
}

command=${1:-}
case $command in
	start)
		[[ $# -eq 1 ]] || { usage >&2; exit 2; }
		start_zephyr
		start_server
		show_status
		;;
	status)
		[[ $# -eq 1 ]] || { usage >&2; exit 2; }
		show_status
		;;
	smoke)
		[[ $# -eq 1 ]] || { usage >&2; exit 2; }
		run_smoke
		;;
	stop)
		if [[ $# -eq 1 ]]; then
			stop_server
		elif [[ $# -eq 2 && $2 == --with-zephyr ]]; then
			stop_server
			stop_zephyr
		else
			usage >&2
			exit 2
		fi
		;;
	*)
		usage >&2
		exit 2
		;;
esac
